# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./resai.db
# For PostgreSQL: postgresql+asyncpg://resai_user:resai_password@localhost:5432/resai_db

# Redis Configuration (Optional, fallback to in-memory cache if unreachable)
REDIS_URL=redis://localhost:6379/0

# LLM Provider Configuration ('groq', 'gemini', or 'openai')
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Search Provider Configuration ('ddg' or 'tavily')
SEARCH_PROVIDER=ddg
TAVILY_API_KEY=
OPENALEX_EMAIL=researcher@resai.local

# Security & CORS
FRONTEND_ORIGIN=http://localhost:5173
SECRET_KEY=resai_super_secret_jwt_key_change_in_production_32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Research Policy & Budget Defaults
MAX_RESEARCH_ITERATIONS=3
MAX_TOOL_CALLS=15
MAX_SOURCES=10
MAX_UPLOAD_SIZE_MB=10
RESEARCH_TIMEOUT_SECONDS=300
CACHE_TTL_SECONDS=3600
LOG_LEVEL=INFO
